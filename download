* {
    box-sizing: border-box;
}

:root {
    --azul-profundo: #1f3a5f;
    --azul: #4f7ca8;
    --azul-claro: #eaf4ff;
    --azul-muy-claro: #f4f9ff;
    --verde-suave: #6f9f8f;
    --arena: #b59b75;
    --gris-texto: #475467;
    --gris-suave: #f8fafc;
    --gris-medio: #d0d5dd;
    --borde: #e4e7ec;
    --blanco: #ffffff;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background:
        radial-gradient(circle at top left, rgba(79, 124, 168, 0.10), transparent 30%),
        radial-gradient(circle at top right, rgba(111, 159, 143, 0.08), transparent 28%),
        linear-gradient(180deg, #f3f6fa, #fbfcfe);
    color: #1d2939;
}

.header {
    background:
        linear-gradient(135deg, rgba(31, 58, 95, 0.96) 0%, rgba(65, 106, 143, 0.94) 58%, rgba(111, 159, 143, 0.92) 100%),
        radial-gradient(circle at 15% 20%, rgba(255,255,255,0.26), transparent 30%);
    color: white;
    padding: 22px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    box-shadow: 0 14px 36px rgba(31, 58, 95, 0.22);
    border-bottom: 1px solid rgba(255,255,255,0.22);
}

.brand-block {
    display: grid;
    gap: 4px;
}

.authors-top {
    display: inline-flex;
    width: fit-content;
    padding: 7px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.28);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2px;
    backdrop-filter: blur(8px);
}

.header h1 {
    margin: 0;
    font-size: 34px;
    letter-spacing: -0.5px;
}

.header p {
    margin: 6px 0 0;
    opacity: 0.92;
}

.header nav {
    display: flex;
    gap: 12px;
}

.header a {
    color: white;
    text-decoration: none;
    padding: 10px 14px;
    border: 1px solid rgba(255,255,255,0.5);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.08);
}

.header a:hover {
    background: rgba(255,255,255,0.18);
}

.container {
    width: min(1440px, 95%);
    margin: 24px auto;
}

.card {
    background: rgba(255, 255, 255, 0.97);
    border-radius: 24px;
    padding: 24px;
    box-shadow: 0 12px 30px rgba(16, 24, 40, 0.085);
    border: 1px solid rgba(228, 231, 236, 0.95);
    backdrop-filter: blur(8px);
}

.hero {
    margin-bottom: 22px;
    border-top: 5px solid var(--azul);
    background: linear-gradient(135deg, #ffffff 0%, #f4f9ff 58%, #f7faf8 100%);
}

.hero h2 {
    margin-top: 0;
    font-size: 30px;
    color: var(--azul-profundo);
}

.grid-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.52fr) minmax(360px, 0.82fr);
    gap: 22px;
    align-items: start;
}

.form-card {
    border-top: 5px solid var(--verde-suave);
}

.result-card {
    border-top: 5px solid #7eb5de;
    background: linear-gradient(180deg, #f4f9ff 0%, #eaf4ff 100%);
    border-color: #c9dff2;
}

.form-card h3,
.result-card h3 {
    margin-top: 0;
}

.symptom-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(170px, 1fr));
    gap: 9px;
    margin: 12px 0 6px;
}

.symptom-item {
    border: 1px solid #d0d5dd;
    border-left: 4px solid var(--verde-suave);
    border-radius: 13px;
    padding: 9px 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    background: #fbfcfe;
    font-size: 14px;
    min-height: 42px;
    transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
}

.symptom-item:nth-child(5n+1) { border-left-color: var(--azul); }
.symptom-item:nth-child(5n+2) { border-left-color: var(--verde-suave); }
.symptom-item:nth-child(5n+3) { border-left-color: var(--arena); }
.symptom-item:nth-child(5n+4) { border-left-color: #8aa0b8; }
.symptom-item:nth-child(5n+5) { border-left-color: #9aa5b1; }

.symptom-item:hover {
    border-color: #b8c9d9;
    background: linear-gradient(135deg, #f4f9ff, #f7faf8);
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(31, 58, 95, 0.10);
}

.symptom-item:has(input:checked) {
    background: linear-gradient(135deg, #eaf4ff, #f1f7f4);
    border-color: #7eb5de;
    box-shadow: 0 8px 18px rgba(79, 124, 168, 0.14);
}

.symptom-item input {
    accent-color: var(--azul);
}

button {
    width: 100%;
    border: none;
    background: linear-gradient(135deg, #416a8f, #6f9f8f);
    color: white;
    padding: 14px 18px;
    font-size: 16px;
    border-radius: 14px;
    cursor: pointer;
    font-weight: bold;
    box-shadow: 0 10px 22px rgba(31, 58, 95, 0.16);
}

button:hover {
    background: linear-gradient(135deg, #365a78, #5c8d7c);
}

.alert {
    background: #fff1f2;
    color: #9f1239;
    border: 1px solid #fecdd3;
    padding: 14px 18px;
    border-radius: 14px;
    margin-bottom: 20px;
}

.risk {
    display: inline-block;
    padding: 9px 14px;
    border-radius: 999px;
    font-weight: bold;
    margin-bottom: 12px;
}

.risk-bajo {
    background: #e9f7ef;
    color: #25603d;
    border: 1px solid #a8d5ba;
}

.risk-medio {
    background: #fff7e6;
    color: #875c19;
    border: 1px solid #e6c98f;
}

.risk-alto {
    background: #fdecec;
    color: #8a1f1f;
    border: 1px solid #efb0b0;
}

.diagnosis {
    border-left: 5px solid var(--azul);
    background: linear-gradient(135deg, #ffffff, #f4f9ff);
    padding: 12px;
    border-radius: 12px;
    margin: 10px 0;
    display: grid;
    gap: 5px;
}

.diagnosis:nth-of-type(3n+1) { border-left-color: var(--azul); }
.diagnosis:nth-of-type(3n+2) { border-left-color: var(--verde-suave); }
.diagnosis:nth-of-type(3n+3) { border-left-color: var(--arena); }

.diagnosis span {
    color: #475467;
}

.diagnosis small {
    color: #667085;
}

.notice,
.empty {
    color: #667085;
    font-size: 14px;
}

.history-list {
    display: grid;
    gap: 16px;
}

.history-item {
    background: linear-gradient(135deg, #ffffff, #f4f9ff);
    border-radius: 16px;
    padding: 16px;
    border: 1px solid #e4e7ec;
    border-left: 5px solid var(--azul);
}

pre {
    white-space: pre-wrap;
    background: linear-gradient(135deg, #1f2937, #334155);
    color: #f2f4f7;
    padding: 14px;
    border-radius: 12px;
    overflow-x: auto;
}

.footer {
    text-align: center;
    padding: 26px 20px;
    color: #667085;
    background: #f8fafc;
    border-top: 1px solid #e4e7ec;
    line-height: 1.6;
}

.footer .authors {
    margin-top: 6px;
    color: #1f3a5f;
    font-weight: bold;
}

.symptoms-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 12px;
}

.helper-text {
    margin: 4px 0 0;
    color: #667085;
    font-size: 14px;
}

.counter {
    background: linear-gradient(135deg, #eaf4ff, #f1f7f4);
    color: #1f3a5f;
    border: 1px solid #c9dff2;
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: bold;
    white-space: nowrap;
}

.symptom-selector-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(340px, 0.94fr);
    gap: 18px;
    align-items: start;
}

.symptom-list-area {
    max-height: 430px;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 10px 12px 10px 10px;
    border: 1px solid #d7dde6;
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(248,250,252,0.98), rgba(255,255,255,0.96));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.8);
    scrollbar-width: thin;
    scrollbar-color: #111827 #e5e7eb;
}

.symptom-list-area::-webkit-scrollbar {
    width: 11px;
}

.symptom-list-area::-webkit-scrollbar-track {
    background: #e5e7eb;
    border-radius: 999px;
}

.symptom-list-area::-webkit-scrollbar-thumb {
    background: #111827;
    border-radius: 999px;
    border: 2px solid #e5e7eb;
}

.symptom-list-area::-webkit-scrollbar-thumb:hover {
    background: #000000;
}

.selected-panel {
    position: sticky;
    top: 18px;
    background: linear-gradient(180deg, #ffffff, #f6f9fc);
    border: 1px solid #d8e5f1;
    border-top: 5px solid var(--azul);
    border-radius: 20px;
    padding: 16px;
    max-height: 430px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #111827 #e5e7eb;
    box-shadow: 0 10px 22px rgba(31, 58, 95, 0.08);
}

.selected-panel::-webkit-scrollbar {
    width: 10px;
}

.selected-panel::-webkit-scrollbar-track {
    background: #e5e7eb;
    border-radius: 999px;
}

.selected-panel::-webkit-scrollbar-thumb {
    background: #111827;
    border-radius: 999px;
    border: 2px solid #e5e7eb;
}

.selected-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
}

.selected-panel h4 {
    margin: 0;
    color: var(--azul-profundo);
}

.clear-button {
    width: auto;
    background: #f2f4f7;
    color: #344054;
    border: 1px solid #d0d5dd;
    padding: 8px 10px;
    font-size: 13px;
    border-radius: 999px;
    box-shadow: none;
}

.clear-button:hover {
    background: #e4e7ec;
}

.selected-symptoms {
    display: grid;
    gap: 10px;
}

.selected-symptom-card {
    position: relative;
    background: white;
    border: 1px solid #d0d5dd;
    border-left: 5px solid var(--azul);
    border-radius: 14px;
    padding: 12px 42px 12px 12px;
    animation: fadeInSelected 0.18s ease-in-out;
    box-shadow: 0 6px 14px rgba(16, 24, 40, 0.06);
}

.selected-symptom-card:nth-child(5n+1) { border-left-color: var(--azul); }
.selected-symptom-card:nth-child(5n+2) { border-left-color: var(--verde-suave); }
.selected-symptom-card:nth-child(5n+3) { border-left-color: var(--arena); }
.selected-symptom-card:nth-child(5n+4) { border-left-color: #8aa0b8; }
.selected-symptom-card:nth-child(5n+5) { border-left-color: #9aa5b1; }

.selected-symptom-card strong {
    display: block;
    margin-bottom: 5px;
    color: #1f3a5f;
}

.selected-symptom-card p {
    margin: 0;
    color: #475467;
    font-size: 14px;
    line-height: 1.35;
}

.remove-symptom {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 26px;
    height: 26px;
    padding: 0;
    border-radius: 50%;
    background: #f2f4f7;
    color: #475467;
    border: 1px solid #d0d5dd;
    font-size: 18px;
    line-height: 1;
    box-shadow: none;
}

.remove-symptom:hover {
    background: #e4e7ec;
    color: #1f2937;
}

.mini {
    margin: 0;
    font-size: 13px;
}

@keyframes fadeInSelected {
    from {
        opacity: 0;
        transform: translateX(8px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@media (max-width: 1200px) {
    .grid-layout {
        grid-template-columns: 1fr;
    }

    .result-card {
        margin-top: 22px;
    }
}

@media (max-width: 950px) {
    .header {
        display: block;
    }

    .header nav {
        margin-top: 18px;
    }

    .symptom-selector-layout {
        grid-template-columns: 1fr;
    }

    .selected-panel {
        position: static;
    }
}

@media (max-width: 760px) {
    .symptom-grid {
        grid-template-columns: 1fr;
    }
}


/* Ajustes finales de estilo */
.form-card {
    background:
        linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248,250,252,0.98));
}

.symptoms-header h3,
.result-card h3 {
    color: var(--azul-profundo);
    letter-spacing: -0.2px;
}

.symptoms-header h3::after,
.result-card h3::after {
    content: "";
    display: block;
    width: 54px;
    height: 3px;
    margin-top: 8px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--azul), var(--verde-suave));
}

.result-card {
    background: linear-gradient(180deg, #eff8ff 0%, #dff0ff 100%);
    border-color: #b9d9f1;
}

.selected-symptoms {
    padding-right: 2px;
}

button[type="submit"] {
    margin-top: 16px;
    letter-spacing: 0.2px;
}

@media (max-width: 760px) {
    .authors-top {
        font-size: 12px;
    }

    .symptom-list-area,
    .selected-panel {
        max-height: 360px;
    }
}
