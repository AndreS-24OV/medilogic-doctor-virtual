* {
    box-sizing: border-box;
}

:root {
    --azul-profundo: #12355b;
    --azul: #2563eb;
    --turquesa: #1f7a8c;
    --menta: #10b981;
    --morado: #7c3aed;
    --rosa: #db2777;
    --naranja: #f97316;
    --amarillo: #f59e0b;
    --rojo: #dc2626;
    --gris-texto: #475467;
    --gris-suave: #f8fafc;
    --borde: #e4e7ec;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background:
        radial-gradient(circle at top left, rgba(37, 99, 235, 0.13), transparent 30%),
        radial-gradient(circle at top right, rgba(219, 39, 119, 0.10), transparent 28%),
        linear-gradient(180deg, #eef3f8, #f9fbff);
    color: #1d2939;
}

.header {
    background: linear-gradient(135deg, #12355b 0%, #1f7a8c 42%, #7c3aed 100%);
    color: white;
    padding: 24px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    box-shadow: 0 12px 32px rgba(18, 53, 91, 0.22);
}

.header h1 {
    margin: 0;
    font-size: 34px;
}

.header p {
    margin: 6px 0 0;
    opacity: 0.92;
}

.header nav {
    display: flex;
    gap: 12px;
}

.header a {
    color: white;
    text-decoration: none;
    padding: 10px 14px;
    border: 1px solid rgba(255,255,255,0.5);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.08);
}

.header a:hover {
    background: rgba(255,255,255,0.18);
}

.container {
    width: min(1100px, 92%);
    margin: 28px auto;
}

.card {
    background: rgba(255, 255, 255, 0.96);
    border-radius: 22px;
    padding: 24px;
    box-shadow: 0 10px 28px rgba(16, 24, 40, 0.09);
    border: 1px solid rgba(228, 231, 236, 0.85);
}

.hero {
    margin-bottom: 22px;
    border-top: 5px solid #7c3aed;
    background: linear-gradient(135deg, #ffffff 0%, #f5f3ff 52%, #eefbfd 100%);
}

.hero h2 {
    margin-top: 0;
    font-size: 30px;
    color: var(--azul-profundo);
}

.grid-layout {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 22px;
}

.form-card {
    border-top: 5px solid var(--turquesa);
}

.result-card {
    border-top: 5px solid var(--morado);
}

.form-card h3,
.result-card h3 {
    margin-top: 0;
}

.symptom-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin: 18px 0;
}

.symptom-item {
    border: 1px solid #d0d5dd;
    border-left: 5px solid var(--turquesa);
    border-radius: 14px;
    padding: 12px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #f9fafb;
    transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
}

.symptom-item:nth-child(6n+1) { border-left-color: var(--turquesa); }
.symptom-item:nth-child(6n+2) { border-left-color: var(--morado); }
.symptom-item:nth-child(6n+3) { border-left-color: var(--menta); }
.symptom-item:nth-child(6n+4) { border-left-color: var(--naranja); }
.symptom-item:nth-child(6n+5) { border-left-color: var(--rosa); }
.symptom-item:nth-child(6n+6) { border-left-color: var(--azul); }

.symptom-item:hover {
    border-color: #93c5fd;
    background: linear-gradient(135deg, #f0fbfd, #f5f3ff);
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(31, 122, 140, 0.12);
}

.symptom-item:has(input:checked) {
    background: linear-gradient(135deg, #ecfeff, #f5f3ff);
    border-color: #7c3aed;
    box-shadow: 0 8px 18px rgba(124, 58, 237, 0.14);
}

.symptom-item input {
    accent-color: var(--morado);
}

button {
    width: 100%;
    border: none;
    background: linear-gradient(135deg, var(--turquesa), var(--morado));
    color: white;
    padding: 14px 18px;
    font-size: 16px;
    border-radius: 14px;
    cursor: pointer;
    font-weight: bold;
    box-shadow: 0 10px 22px rgba(31, 122, 140, 0.18);
}

button:hover {
    background: linear-gradient(135deg, #155e70, #6d28d9);
}

.alert {
    background: #ffe4e6;
    color: #9f1239;
    border: 1px solid #fecdd3;
    padding: 14px 18px;
    border-radius: 14px;
    margin-bottom: 20px;
}

.risk {
    display: inline-block;
    padding: 9px 14px;
    border-radius: 999px;
    font-weight: bold;
    margin-bottom: 12px;
}

.risk-bajo {
    background: #dcfce7;
    color: #166534;
    border: 1px solid #86efac;
}

.risk-medio {
    background: #fef3c7;
    color: #92400e;
    border: 1px solid #fcd34d;
}

.risk-alto {
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fca5a5;
}

.diagnosis {
    border-left: 5px solid var(--turquesa);
    background: linear-gradient(135deg, #f8fafc, #f0f9ff);
    padding: 12px;
    border-radius: 12px;
    margin: 10px 0;
    display: grid;
    gap: 5px;
}

.diagnosis:nth-of-type(3n+1) { border-left-color: var(--morado); }
.diagnosis:nth-of-type(3n+2) { border-left-color: var(--menta); }
.diagnosis:nth-of-type(3n+3) { border-left-color: var(--naranja); }

.diagnosis span {
    color: #475467;
}

.diagnosis small {
    color: #667085;
}

.notice,
.empty {
    color: #667085;
    font-size: 14px;
}

.history-list {
    display: grid;
    gap: 16px;
}

.history-item {
    background: linear-gradient(135deg, #f8fafc, #f5f3ff);
    border-radius: 16px;
    padding: 16px;
    border: 1px solid #e4e7ec;
    border-left: 5px solid var(--morado);
}

pre {
    white-space: pre-wrap;
    background: linear-gradient(135deg, #101828, #1e1b4b);
    color: #f2f4f7;
    padding: 14px;
    border-radius: 12px;
    overflow-x: auto;
}

.footer {
    text-align: center;
    padding: 24px;
    color: #667085;
}

@media (max-width: 850px) {
    .header,
    .grid-layout {
        display: block;
    }

    .header nav {
        margin-top: 18px;
    }

    .result-card {
        margin-top: 22px;
    }

    .symptom-grid {
        grid-template-columns: 1fr;
    }
}

.symptoms-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 12px;
}

.helper-text {
    margin: 4px 0 0;
    color: #667085;
    font-size: 14px;
}

.counter {
    background: linear-gradient(135deg, #e0f2fe, #ede9fe);
    color: #075985;
    border: 1px solid #bae6fd;
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: bold;
    white-space: nowrap;
}

.symptom-selector-layout {
    display: grid;
    grid-template-columns: 1fr 0.82fr;
    gap: 16px;
    align-items: start;
}

.symptom-list-area {
    max-height: 620px;
    overflow-y: auto;
    padding-right: 6px;
}

.symptom-list-area::-webkit-scrollbar,
.selected-panel::-webkit-scrollbar {
    width: 8px;
}

.symptom-list-area::-webkit-scrollbar-thumb,
.selected-panel::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, var(--turquesa), var(--morado));
    border-radius: 999px;
}

.selected-panel {
    position: sticky;
    top: 18px;
    background: linear-gradient(180deg, #ffffff, #f8fafc);
    border: 1px solid #e4e7ec;
    border-top: 5px solid var(--rosa);
    border-radius: 18px;
    padding: 16px;
    max-height: 620px;
    overflow-y: auto;
}

.selected-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
}

.selected-panel h4 {
    margin: 0;
    color: var(--azul-profundo);
}

.clear-button {
    width: auto;
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fecaca;
    padding: 8px 10px;
    font-size: 13px;
    border-radius: 999px;
    box-shadow: none;
}

.clear-button:hover {
    background: #fecaca;
}

.selected-symptoms {
    display: grid;
    gap: 10px;
}

.selected-symptom-card {
    position: relative;
    background: white;
    border: 1px solid #d0d5dd;
    border-left: 5px solid #1f7a8c;
    border-radius: 14px;
    padding: 12px 42px 12px 12px;
    animation: fadeInSelected 0.18s ease-in-out;
    box-shadow: 0 6px 14px rgba(16, 24, 40, 0.06);
}

.selected-symptom-card:nth-child(6n+1) { border-left-color: var(--turquesa); }
.selected-symptom-card:nth-child(6n+2) { border-left-color: var(--morado); }
.selected-symptom-card:nth-child(6n+3) { border-left-color: var(--menta); }
.selected-symptom-card:nth-child(6n+4) { border-left-color: var(--naranja); }
.selected-symptom-card:nth-child(6n+5) { border-left-color: var(--rosa); }
.selected-symptom-card:nth-child(6n+6) { border-left-color: var(--azul); }

.selected-symptom-card strong {
    display: block;
    margin-bottom: 5px;
    color: #12355b;
}

.selected-symptom-card p {
    margin: 0;
    color: #475467;
    font-size: 14px;
    line-height: 1.35;
}

.remove-symptom {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 26px;
    height: 26px;
    padding: 0;
    border-radius: 50%;
    background: #f2f4f7;
    color: #475467;
    border: 1px solid #d0d5dd;
    font-size: 18px;
    line-height: 1;
    box-shadow: none;
}

.remove-symptom:hover {
    background: #fee2e2;
    color: #991b1b;
}

.mini {
    margin: 0;
    font-size: 13px;
}

@keyframes fadeInSelected {
    from {
        opacity: 0;
        transform: translateX(8px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@media (max-width: 1100px) {
    .symptom-selector-layout {
        grid-template-columns: 1fr;
    }

    .selected-panel {
        position: static;
        max-height: none;
    }
}
